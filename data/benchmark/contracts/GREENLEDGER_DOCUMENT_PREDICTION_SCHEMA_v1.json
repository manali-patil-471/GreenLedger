{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenledger.invalid/data/benchmark/contracts/GREENLEDGER_DOCUMENT_PREDICTION_SCHEMA_v1.json",
  "title": "GreenLedger evidence-only document prediction",
  "schema_version": "1.0",
  "description": "Benchmark-only intermediate representation for observed evidence and evidence-readiness predictions. It intentionally excludes Scope/category decisions, factor selection, emissions, and accounting results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "document_id",
    "extracted_fields",
    "missing_evidence",
    "ambiguities",
    "accounting_readiness",
    "review_signal",
    "model_metadata"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "document_id": { "type": "string", "minLength": 1 },
    "extracted_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field_prediction" }
    },
    "missing_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/missing_evidence" }
    },
    "ambiguities": {
      "type": "array",
      "items": { "$ref": "#/$defs/ambiguity" }
    },
    "accounting_readiness": {
      "enum": ["READY", "INCOMPLETE", "AMBIGUOUS", "UNDETERMINED"]
    },
    "review_signal": { "$ref": "#/$defs/review_signal" },
    "model_metadata": { "$ref": "#/$defs/model_metadata" }
  },
  "$defs": {
    "scalar_or_null": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "null" }
      ]
    },
    "bounding_box": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "page", "bounding_box"],
      "properties": {
        "text": { "type": "string" },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "bounding_box": { "$ref": "#/$defs/bounding_box" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_value", "normalized_value", "raw_unit", "normalized_unit", "confidence", "evidence"],
      "properties": {
        "raw_value": { "$ref": "#/$defs/scalar_or_null" },
        "normalized_value": { "$ref": "#/$defs/scalar_or_null" },
        "raw_unit": { "type": ["string", "null"] },
        "normalized_unit": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_reference" }
        }
      }
    },
    "field_prediction": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "evidence_status": { "enum": ["MISSING", "UNDETERMINED"] } } },
          "then": { "properties": { "candidates": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "evidence_status": { "const": "PRESENT" } } },
          "then": { "properties": { "candidates": { "minItems": 1, "maxItems": 1 } } }
        },
        {
          "if": { "properties": { "evidence_status": { "const": "INSUFFICIENT" } } },
          "then": { "properties": { "candidates": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "candidate_state": { "const": "NO_CANDIDATE" } } },
          "then": { "properties": { "candidates": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "candidate_state": { "const": "SINGLE_CANDIDATE" } } },
          "then": { "properties": { "candidates": { "minItems": 1, "maxItems": 1 } } }
        },
        {
          "if": { "properties": { "candidate_state": { "const": "MULTIPLE_CANDIDATES" } } },
          "then": { "properties": { "candidates": { "minItems": 2 } } }
        }
      ],
      "required": ["field_name", "evidence_status", "candidate_state", "candidates", "source_status", "reason"],
      "properties": {
        "field_name": {
          "enum": [
            "document_type", "document_domain", "activity_description", "supplier_name", "document_date",
            "billing_period", "quantity", "unit", "net_lpg_mass", "material_identity",
            "geography", "electricity_use", "vehicle_reference", "source_type",
            "combustion_status", "operational_control", "commercial_institutional",
            "purchase_evidence", "transport_mode", "transport_scenario", "shipment_mass",
            "shipment_mass_unit", "distance", "distance_unit", "transport_vehicle_class"
          ]
        },
        "evidence_status": {
          "enum": ["PRESENT", "MISSING", "INSUFFICIENT", "AMBIGUOUS", "UNDETERMINED"]
        },
        "candidate_state": {
          "enum": ["NO_CANDIDATE", "SINGLE_CANDIDATE", "MULTIPLE_CANDIDATES"]
        },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate" }
        },
        "source_status": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "missing_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_name", "reason", "evidence"],
      "properties": {
        "field_name": { "$ref": "#/$defs/field_prediction/properties/field_name" },
        "reason": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_reference" }
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_name", "candidates", "evidence", "reason"],
      "properties": {
        "field_name": { "$ref": "#/$defs/field_prediction/properties/field_name" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_reference" }
        },
        "reason": { "type": ["string", "null"] }
      }
    },
    "review_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_required", "human_confirmation_required",
        "explicit_missing_evidence_signal", "explicit_ambiguity_signal", "reasons"
      ],
      "properties": {
        "review_required": { "type": ["boolean", "null"] },
        "human_confirmation_required": { "type": ["boolean", "null"] },
        "explicit_missing_evidence_signal": { "type": ["boolean", "null"] },
        "explicit_ambiguity_signal": { "type": ["boolean", "null"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "model_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_name", "candidate_version", "adapter_version",
        "confidence_calibrated", "confidence_note", "evidence_localization_method"
      ],
      "properties": {
        "candidate_name": { "type": "string", "minLength": 1 },
        "candidate_version": { "type": ["string", "null"] },
        "adapter_version": { "type": "string" },
        "confidence_calibrated": { "type": ["boolean", "null"] },
        "confidence_note": { "type": ["string", "null"] },
        "evidence_localization_method": { "type": ["string", "null"] }
      }
    }
  }
}
